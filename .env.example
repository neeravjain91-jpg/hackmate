# ==============================================================================
# HACKMATE — Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Driver: "local" (default offline/test persistent storage) or "supabase"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
LOCAL_DB_PATH=./data/hackmate.json

# Maximum File Upload Size in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Supabase Configuration (Optional for cloud deployment, required if STORAGE_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=hackmate-contributions

# Local Authentication Secret (Used for session token generation when running locally)
AUTH_SECRET=hackmate-local-session-secret-change-in-production
