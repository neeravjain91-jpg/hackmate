# ==============================================================================
# HACKMATE — Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Driver: "local" (default offline/test persistent storage) or "supabase"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
LOCAL_DB_PATH=./data/hackmate.json

# Maximum File Upload Size in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Supabase Configuration (Optional for cloud deployment, required if STORAGE_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=hackmate-contributions

# Authentication Secret (Used for HMAC-SHA256 session token signing and verification)
# In local development/test, a built-in default is used if left blank.
# In production (NODE_ENV=production), AUTH_SECRET is mandatory, must be at least 32 bytes,
# and must NOT use placeholder or default values.
# Generate a cryptographically secure random production secret with:
#   openssl rand -base64 32
AUTH_SECRET=hackmate-local-session-secret-change-in-production

