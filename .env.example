# ==============================================================================
# HACKMATE — Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Driver: "local" (persistent self-hosted volume/local dev) or "supabase" (cloud PostgreSQL)
# - In local development, defaults to "local" for zero-config offline use.
# - In self-hosted production with persistent writable volumes, explicitly set STORAGE_DRIVER=local.
# - For Vercel or other serverless platforms, STORAGE_DRIVER=supabase is strictly required
#   because serverless local filesystems are ephemeral and cannot preserve student work.
# - In production (NODE_ENV=production), STORAGE_DRIVER must be explicitly configured;
#   missing or invalid configuration fails closed to prevent silent data loss.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
LOCAL_DB_PATH=./data/hackmate.json

# Maximum File Upload Size in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Supabase Configuration (Required when STORAGE_DRIVER=supabase and on Vercel deployments)
# Apply migrations sequentially from supabase/migrations/ before connecting.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=hackmate-contributions

# Authentication Secret (Used for HMAC-SHA256 session token signing and verification)
# In local development/test, a built-in default is used if left blank.
# In production (NODE_ENV=production), AUTH_SECRET is mandatory, must be at least 32 bytes,
# and must NOT use placeholder, default, single-symbol, or predictable repeating patterns.
# Generate a cryptographically secure random production secret with:
#   openssl rand -base64 32
AUTH_SECRET=hackmate-local-session-secret-change-in-production


